# datasets (downloaded from zenodo - see README). Pure is 194MB; 1K/27K are multi-GB,
# so match every variant rather than naming one - an unignored variant silently stages
# gigabytes into the index.
KuaiRand-*/
KuaiRand-*.tar.gz

# environment
.venv/
__pycache__/
*.pyc

# large intermediates; experiment results (json/jsonl/log) are tracked
runs/cache/
runs/cache_*/
runs/*.npy

# never commit credentials
*_env.sh
.env
*.key
